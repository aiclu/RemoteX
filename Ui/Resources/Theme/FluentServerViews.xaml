<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:view="clr-namespace:_1RM.View">
    <!-- Only explicitly scoped connection views consume these templates. -->
    <!-- Tag management replaces the connection content; hiding it preserves selection, scroll and expansion state. -->
    <Style x:Key="ServerConnectionsPanel" TargetType="Grid">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding TagListViewModel}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TagManagementBody" TargetType="Grid">
        <Setter Property="Margin" Value="0,21,0,0"/>
        <Style.Triggers><Trigger Property="view:FluentWorkspace.IsPreview" Value="True"><Setter Property="Margin" Value="0"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="TagManagementLegacySpacer" TargetType="RowDefinition">
        <Setter Property="Height" Value="20"/>
        <Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=(view:FluentWorkspace.IsPreview)}" Value="True">
            <Setter Property="Height" Value="0"/>
        </DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="FluentSourceAction" TargetType="Button">
        <Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="6"/><Setter Property="Foreground" Value="{DynamicResource FluentMuted}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FluentHover}"/><Setter Property="Foreground" Value="{DynamicResource FluentText}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FluentAccent}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.7"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <ControlTemplate x:Key="FluentSourceExpanderTemplate" TargetType="Expander">
        <Border x:Name="SourceCard" Background="{DynamicResource FluentSurface}" BorderBrush="{DynamicResource FluentStroke}"
                BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
            <DockPanel LastChildFill="True">
                <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top" MinHeight="44" Padding="12,4" Style="{x:Null}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource FluentText}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              Content="{TemplateBinding Header}" AutomationProperties.Name="{Binding Name.DataSourceName}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="HeaderChrome" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="HeaderFocus" BorderBrush="{DynamicResource FluentAccent}" BorderThickness="1" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderChrome" Property="Background" Value="{DynamicResource FluentHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderChrome" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderFocus" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Margin="4,0,4,8" Visibility="Collapsed"/>
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="view:FluentWorkspace.IsPreview" Value="True"><Setter TargetName="ExpandSite" Property="Margin" Value="0,0,0,8"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="FluentTreeLayout" TargetType="TreeView">
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Style.Triggers>
            <!-- Hierarchical virtualization can repeatedly invalidate layout on scrolling.
                 Keep the stability fallback local to Fluent trees; list virtualization is unchanged. -->
            <Trigger Property="view:FluentPage.Active" Value="True">
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="False"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <ControlTemplate x:Key="FluentTreeItemTemplate" TargetType="TreeViewItem">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <!-- WPF uses PART_Header.DesiredSize for hierarchical virtualization.
                 It must include the whole row, not just the text inside its padded border. -->
            <Border x:Name="Row" Grid.ColumnSpan="2" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"/>
            <Border x:Name="SelectedMark" Width="3" Height="20" CornerRadius="2" Background="{DynamicResource FluentAccent}" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <ToggleButton x:Name="Expander" Width="24" MinHeight="36" Focusable="False"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"><Path x:Name="Arrow" Width="6" Height="10" Stretch="Fill" Data="M 0,0 L 5,5 L 0,10"
                        Stroke="{DynamicResource FluentMuted}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5"/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource FluentAccent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <Border x:Name="PART_Header" Grid.Column="1" MinHeight="40" Padding="4,2,8,2" Background="Transparent">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger SourceName="PART_Header" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource FluentHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource FluentHover}"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource FluentAccent}"/></Trigger>
            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="FluentCardBody" TargetType="Grid">
        <Setter Property="Width" Value="144"/><Setter Property="Height" Value="144"/>
        <Setter Property="Clip"><Setter.Value><RectangleGeometry Rect="0,0,144,144" RadiusX="8" RadiusY="8"/></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
            <Setter Property="Width" Value="184"/><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="204"/>
            <Setter Property="Clip" Value="{x:Null}"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="FluentCardCell" TargetType="Grid">
        <Setter Property="Width" Value="165"/><Setter Property="Height" Value="164"/>
        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
            <Setter Property="Width" Value="200"/><Setter Property="Height" Value="Auto"/><Setter Property="Margin" Value="0,0,0,12"/>
        </Trigger></Style.Triggers>
    </Style>
</ResourceDictionary>
