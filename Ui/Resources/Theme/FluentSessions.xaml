<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:view="clr-namespace:_1RM.View">
    <!-- Header-only surfaces: never alias resources on the protocol content. -->
    <Style x:Key="SessionHeaderSurface" TargetType="Panel">
        <Setter Property="Background" Value="{DynamicResource PrimaryMidBrush}"/>
        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
            <Setter Property="Background" Value="{DynamicResource FluentCanvas}"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SessionHeaderPrefix" TargetType="StackPanel" BasedOn="{StaticResource SessionHeaderSurface}">
        <Setter Property="Margin" Value="5,0"/>
        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
            <Setter Property="Margin" Value="8,0,6,0"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SessionHeaderLegacyColorBorder" TargetType="Border">
        <Setter Property="BorderThickness" Value="0,0,0,5"/>
        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SessionClassicGlyph" TargetType="Path">
        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SessionFluentGlyph" TargetType="Path">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="StrokeThickness" Value="1.25"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Stretch" Value="Uniform"/>
        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
        </Trigger></Style.Triggers>
    </Style>
    <ControlTemplate x:Key="SessionHeaderActionTemplate" TargetType="Button">
        <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FluentHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FluentStroke}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FluentAccent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="SessionButtonTemplate" TargetType="Button">
                <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Margin="2">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FluentHover}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FluentStroke}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FluentAccent}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="SessionDanger"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                        <Setter TargetName="Chrome" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/>
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
    <Style x:Key="SessionChromeButton" TargetType="Button" BasedOn="{StaticResource ButtonBarPrimaryStyle}">
        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource FluentText}"/>
            <Setter Property="Template" Value="{StaticResource SessionButtonTemplate}"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SessionTabButton" TargetType="Button" BasedOn="{StaticResource ButtonBarAccentStyle}">
        <Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/>
        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource FluentText}"/>
            <Setter Property="Template" Value="{StaticResource SessionHeaderActionTemplate}"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="SessionLauncherButton" TargetType="Button" BasedOn="{StaticResource SessionChromeButton}">
        <Setter Property="Width" Value="25"/><Setter Property="Height" Value="30"/>
        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template" Value="{StaticResource SessionHeaderActionTemplate}"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemPrimaryStyle}">
        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
            <Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8,4"/>
        </Trigger></Style.Triggers>
    </Style>
</ResourceDictionary>
