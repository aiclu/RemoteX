<UserControl x:Class="_1RM.View.Editor.Forms.Utils.CredentialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:_1RM.Controls"
             xmlns:s="https://github.com/canton7/Stylet"
             xmlns:utils="clr-namespace:_1RM.View.Editor.Forms.Utils"
             xmlns:view="clr-namespace:_1RM.View"
             xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance utils:CredentialViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RemoteX;component/Resources/Theme/FluentForms.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- These resources are local to credentials; classic resources and bindings stay intact. -->
            <ControlTemplate x:Key="CredentialModeTemplate" TargetType="Button">
                <Grid SnapsToDevicePixels="True">
                    <Border x:Name="Chrome" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <Border x:Name="SelectionMark" Width="24" Height="2" CornerRadius="1" VerticalAlignment="Bottom"
                            BorderBrush="{DynamicResource FluentAccent}" BorderThickness="{TemplateBinding BorderThickness}"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FluentHover}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource FluentSelection}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FluentAccent}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <Style x:Key="CredentialModeButton" TargetType="Button" BasedOn="{StaticResource ButtonBarAccentStyle}">
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="attachProperty:VisionElement.BorderCornerRadius" Value="4,4,0,0"/>
                <Style.Triggers>
                    <Trigger Property="view:FluentPage.Active" Value="True">
                        <Setter Property="Template" Value="{StaticResource CredentialModeTemplate}"/>
                        <Setter Property="MinHeight" Value="36"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="Margin" Value="0,0,4,0"/>
                        <Setter Property="Foreground" Value="{DynamicResource FluentText}"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CredentialTitle" TargetType="TextBlock" BasedOn="{StaticResource FluentEditorGroupTextBlockTitle}">
                <Setter Property="Width" Value="500"/>
                <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Width" Value="Auto"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="CredentialModeSpacer" TargetType="TextBlock" BasedOn="{StaticResource FluentEditorRowGridTitle}">
                <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="CredentialModeRow" TargetType="Grid" BasedOn="{StaticResource FluentEditorRowGrid}">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Margin" Value="16,0,16,8"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="CredentialModeScroll" TargetType="ScrollViewer">
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Focusable" Value="False"/>
                <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="CredentialPanelBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentMidBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Margin" Value="20,0"/>
                <Setter Property="Width" Value="700"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
                <Style.Triggers>
                    <Trigger Property="view:FluentPage.Active" Value="True">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource FluentStroke}"/>
                        <Setter Property="Background" Value="{DynamicResource FluentSurface}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="CredentialBody" TargetType="StackPanel">
                <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Margin" Value="16,0,16,4"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="CredentialVaultRow" TargetType="Grid" BasedOn="{StaticResource FluentEditorRowGrid}">
                <Setter Property="Margin" Value="0,15,0,0"/>
                <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Margin" Value="0,16,0,0"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="CredentialUserRow" TargetType="Grid" BasedOn="{StaticResource FluentEditorRowGrid}">
                <Setter Property="Margin" Value="0,15"/>
                <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Margin" Value="0,16,0,12"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="CredentialPassword" TargetType="controls:PasswordInput">
                <Setter Property="Height" Value="32"/>
                <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="32"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="CredentialPrivateKeyInput" TargetType="Grid" BasedOn="{StaticResource FluentEditorRowGridInput}">
                <Setter Property="Height" Value="32"/>
                <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Height" Value="Auto"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="CredentialOptionContent" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
                    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
                </Trigger></Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="0 0 0 15">

        <TextBlock Style="{StaticResource CredentialTitle}" Text="{DynamicResource Credentials}"></TextBlock>

        <Grid Style="{StaticResource CredentialModeRow}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource CredentialModeSpacer}"/>
                <ScrollViewer Style="{StaticResource CredentialModeScroll}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style><Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="0,0,0,-1"/>
                        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Margin" Value="0"/></Trigger></Style.Triggers>
                    </Style></StackPanel.Style>
                    <Button x:Name="ManualCredentialMode" Command="{Binding CmdUseManuallyCredential}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource User}"></TextBlock>
                            <TextBlock Text=" &amp; "></TextBlock>
                            <TextBlock Text="{DynamicResource Password}"></TextBlock>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CredentialModeButton}">
                                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCredentialName}" Value="">
                                        <Setter Property="Background" Value="{DynamicResource AccentMidBrush}"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(view:FluentPage.Active)}" Value="True"/>
                                            <Condition Binding="{Binding SelectedCredentialName}" Value=""/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="VaultCredentialMode" Content="{Binding StrBtnUseCredentialsVault}" Command="{Binding CmdUseCredentialsVault}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CredentialModeButton}">
                                <Setter Property="Background" Value="{DynamicResource AccentMidBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedCredentialName}" Value="">
                                        <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                                    </DataTrigger>
                                    <Trigger Property="view:FluentPage.Active" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                    </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(view:FluentPage.Active)}" Value="True"/>
                                            <Condition Binding="{Binding SelectedCredentialName}" Value=""/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <Grid>
            <Border x:Name="CredentialPanel" Style="{StaticResource CredentialPanelBorder}"/>

            <StackPanel Style="{StaticResource CredentialBody}">
                <Grid x:Name="VaultCredentialRow" Style="{StaticResource CredentialVaultRow}"
                      Visibility="{Binding SelectedCredentialName, Converter={StaticResource ConverterEqual2Collapsed}, ConverterParameter=''}">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel" BasedOn="{StaticResource FluentFieldStack}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=New.DataSource}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"></Setter>
                                        <Setter Property="Opacity" Value="0.5"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Style="{StaticResource FluentEditorRowGridTitle}" Text="{DynamicResource Select}"></TextBlock>
                        <!-- Credentials ComboBox -->
                        <Grid Style="{StaticResource FluentEditorRowGridInput}">
                            <ComboBox x:Name="VaultCredentialSelector" SelectedValuePath="Name"
                                      IsEditable="False"
                                      DisplayMemberPath="Name" 
                                      Tag="{DynamicResource 'Select credentials within the same database'}"
                                      SelectedItem="{Binding SelectedCredential}"
                                      ItemsSource="{Binding Credentials}"></ComboBox>
                        </Grid>
                        <!--ADD BUTTON-->
                        <Button x:Name="AddVaultCredential" Command="{Binding CmdAdd}" ToolTip="{DynamicResource Add}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource FluentPageButton}" TargetType="Button">
                                    <Setter Property="BorderThickness" Value="0"></Setter>
                                    <Setter Property="Padding" Value="5,0"/>
                                    <Setter Property="Height" Value="20"/>
                                    <Setter Property="Margin" Value="5,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="attachProperty:VisionElement.BackgroundAccent" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Setter Property="attachProperty:VisionElement.BackgroundOnMouseDown" Value="{DynamicResource PrimaryLightBrush}"/>
                                    <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
                                        <Setter Property="Height" Value="Auto"/><Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="32"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="8,0,0,0"/>
                                    </Trigger>
                                    <Trigger Property="view:FluentPage.Narrow" Value="True"><Setter Property="Margin" Value="0,8,0,0"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Height="12" UseLayoutRounding="True" 
                                      Data="{StaticResource GeometryCross}" 
                                      Fill="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=Button}, Path=Foreground}" 
                                      Stretch="Uniform"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="ManualCredentialFields">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="IsEnabled" Value="False"></Setter>
                            <Setter Property="Opacity" Value="0.5"></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=SelectedCredentialName}" Value="">
                                    <Setter Property="IsEnabled" Value="True"></Setter>
                                    <Setter Property="Opacity" Value="1"></Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid Style="{StaticResource CredentialUserRow}">
                        <StackPanel Style="{StaticResource FluentFieldStack}">
                            <TextBlock Style="{StaticResource FluentEditorRowGridTitle}" Text="{DynamicResource User}"></TextBlock>
                            <Grid Style="{StaticResource FluentEditorRowGridInput}">
                                <TextBox x:Name="CredentialUserName" Text="{Binding New.UserName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True, ValidatesOnExceptions=True, ValidatesOnNotifyDataErrors=True}">
                                </TextBox>
                            </Grid>
                        </StackPanel>
                    </Grid>


                    <Grid x:Name="CredentialPasswordRow">
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource FluentEditorRowGrid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUsePrivateKey}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel Style="{StaticResource FluentFieldStack}">
                            <TextBlock Style="{StaticResource FluentEditorRowGridTitle}" Text="{DynamicResource Password}"></TextBlock>
                            <Grid Style="{StaticResource FluentEditorRowGridInput}">
                                <controls:PasswordInput x:Name="CredentialPasswordInput" Style="{StaticResource CredentialPassword}"
                                                        Tag="leave it blank and it will prompt for the password later."
                                                        Password="{Binding New.Password, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True, ValidatesOnExceptions=True, ValidatesOnNotifyDataErrors=True}">
                                </controls:PasswordInput>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="CredentialPrivateKeyRow">
                        <Grid.Style>
                            <Style TargetType="Grid" BasedOn="{StaticResource FluentEditorRowGrid}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUsePrivateKey}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel>
                            <StackPanel Style="{StaticResource FluentFieldStack}">
                                <TextBlock Style="{StaticResource FluentEditorRowGridTitle}" Text="{DynamicResource 'Private key'}"></TextBlock>
                                <Grid Style="{StaticResource CredentialPrivateKeyInput}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="TbPrivateKey" Text="{Binding New.PrivateKey}"></TextBox>
                                    <Button Grid.Column="1"
                                            Content="{DynamicResource Select}" 
                                            Click="{s:Action ButtonSelectPrivateKey_OnClick}" 
                                            Style="{StaticResource FluentPageButton}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch">
                                    </Button>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{DynamicResource 'Supports the Putty-key only'}" TextWrapping="Wrap">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource FluentMuted}"/><Setter Property="Margin" Value="0,4,0,0"/></Trigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock
                                           Margin="5 0 0 0"
                                           VerticalAlignment="Center"
                                           Text="{DynamicResource 'Supports the Putty-key only'}" Opacity="0.7">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                        <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Grid Style="{StaticResource FluentEditorRowGrid}">
                    <StackPanel Style="{StaticResource FluentFieldStack}">
                        <TextBlock Text=""><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource FluentEditorRowGridTitle}"><Style.Triggers>
                            <Trigger Property="view:FluentPage.Narrow" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                        </Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <StackPanel>
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Orientation" Value="Horizontal"/><Style.Triggers>
                                <Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Orientation" Value="Vertical"/></Trigger>
                            </Style.Triggers></Style></StackPanel.Style>
                        <CheckBox x:Name="AskForPassword" Style="{StaticResource CredentialOptionContent}" Content="{DynamicResource 'Ask for password when open connect'}" IsChecked="{Binding New.AskPasswordWhenConnect}"></CheckBox>
                        <CheckBox Name="CbUsePrivateKey"
                                  Visibility="{Binding ShowPrivateKeyInput, Converter={StaticResource ConverterBool2Visible}}"
                                  IsChecked="{Binding IsUsePrivateKey}"
                                  Content="{DynamicResource 'Use private key'}" >
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource CredentialOptionContent}">
                                    <Setter Property="Margin" Value="5,0,0,0"></Setter>
                                    <Setter Property="IsEnabled" Value="False"></Setter>
                                    <Setter Property="Opacity" Value="0.5"></Setter>
                                    <Style.Triggers>
                                        <Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Margin" Value="0,4,0,0"/></Trigger>
                                        <DataTrigger Binding="{Binding Path=SelectedCredentialName}" Value="">
                                            <Setter Property="IsEnabled" Value="True"></Setter>
                                            <Setter Property="Opacity" Value="1"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Grid>



            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
