<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fluent="clr-namespace:_1RM.View"
                    xmlns:controls="clr-namespace:_1RM.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/RemoteX;component/Resources/Theme/FluentDialogs.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Only this dialog opts in; classic geometry, validation and commands remain unchanged. -->
    <ControlTemplate x:Key="CredentialDialogErrorOutline">
        <Border BorderBrush="{DynamicResource FluentError}" BorderThickness="1" CornerRadius="6">
            <AdornedElementPlaceholder/>
        </Border>
    </ControlTemplate>
    <Style x:Key="CredentialDialogErrors" TargetType="ItemsControl">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
            <TextBlock Style="{StaticResource TextBlockBase}" Text="{Binding ErrorContent}"
                       Foreground="{DynamicResource FluentError}" TextWrapping="Wrap"/>
        </DataTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <MultiTrigger><MultiTrigger.Conditions>
                <Condition Property="fluent:FluentPage.Active" Value="True"/>
                <Condition Property="HasItems" Value="True"/>
            </MultiTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CredentialDialogLabel" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="15,0,0,0"/>
        <Setter Property="Width" Value="100"/>
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource FluentText}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CredentialDialogRow" TargetType="Grid">
        <Setter Property="fluent:FluentFieldLayout.FlattenRows" Value="True"/>
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True">
            <Setter Property="fluent:FluentFieldLayout.Enabled" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxAccentStyle}">
        <Setter Property="Height" Value="26"/>
        <Style.Triggers>
            <Trigger Property="fluent:FluentPage.Active" Value="True">
                <Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="36"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource FluentText}"/>
                <Setter Property="Background" Value="{DynamicResource FluentSurface}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource FluentStroke}"/>
                <Setter Property="Validation.ErrorTemplate" Value="{StaticResource CredentialDialogErrorOutline}"/>
            </Trigger>
            <!-- Vault entries do not inherit a connection's defaults. -->
            <MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(fluent:FluentPage.Active)}" Value="True"/>
                <Condition Binding="{Binding ShowHost}" Value="False"/>
            </MultiDataTrigger.Conditions><Setter Property="Tag" Value="{x:Null}"/></MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordBoxAccentStyle}">
        <Setter Property="Height" Value="26"/>
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True">
            <Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource FluentText}"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CredentialDialogPassword" TargetType="controls:PasswordInput">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Tag" Value="{DynamicResource 'Leave blank to inherit the default value'}"/>
        <Style.Triggers>
            <Trigger Property="fluent:FluentPage.Active" Value="True">
                <Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="36"/>
                <Setter Property="Validation.ErrorTemplate" Value="{StaticResource CredentialDialogErrorOutline}"/>
            </Trigger>
            <MultiDataTrigger><MultiDataTrigger.Conditions>
                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(fluent:FluentPage.Active)}" Value="True"/>
                <Condition Binding="{Binding ShowHost}" Value="False"/>
            </MultiDataTrigger.Conditions><Setter Property="Tag" Value="{x:Null}"/></MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CredentialDialogInheritedInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Tag" Value="{DynamicResource 'Leave blank to inherit the default value'}"/>
    </Style>
    <Style x:Key="CredentialDialogPrivateKey" TargetType="TextBox" BasedOn="{StaticResource CredentialDialogInheritedInput}">
        <Setter Property="Width" Value="280"/><Setter Property="HorizontalAlignment" Value="Left"/>
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True">
            <Setter Property="Width" Value="Auto"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CredentialDialogFilePicker" TargetType="Button" BasedOn="{StaticResource FluentPageButton}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True">
            <Setter Property="Grid.Column" Value="1"/><Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,6"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxAccentStyle}">
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True">
            <Setter Property="Margin" Value="0,8,0,0"/><Setter Property="MinHeight" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource FluentText}"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <TextBlock Style="{StaticResource TextBlockBase}" Text="{Binding}" Foreground="{DynamicResource FluentText}" TextWrapping="Wrap"/>
            </DataTemplate></Setter.Value></Setter>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CredentialDialogShell" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimaryMidBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True">
            <Setter Property="Background" Value="{DynamicResource FluentSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FluentStroke}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CredentialDialogBody" TargetType="StackPanel">
        <Setter Property="Margin" Value="20,0"/>
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True"><Setter Property="Margin" Value="8,4,8,0"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CredentialDialogTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeSubtitle}"/>
        <Setter Property="Margin" Value="15"/><Setter Property="MinHeight" Value="30"/>
        <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource FluentText}"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeTitle}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CredentialDialogActions" TargetType="WrapPanel">
        <Setter Property="Margin" Value="0,0,0,20"/><Setter Property="HorizontalAlignment" Value="Center"/>
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True">
            <Setter Property="Margin" Value="4,4,8,4"/><Setter Property="HorizontalAlignment" Value="Right"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CredentialDialogButton" TargetType="Button" BasedOn="{StaticResource FluentPageButton}">
        <Setter Property="MinWidth" Value="100"/><Setter Property="Margin" Value="10,0"/>
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True">
            <Setter Property="MinWidth" Value="88"/><Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="16,6"/><Setter Property="Margin" Value="8,0,0,0"/>
        </Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CredentialDialogSave" TargetType="Button" BasedOn="{StaticResource CredentialDialogButton}">
        <Style.Triggers><Trigger Property="fluent:FluentPage.Active" Value="True">
            <Setter Property="Foreground" Value="{DynamicResource FluentAccentText}"/>
            <Setter Property="Background" Value="{DynamicResource FluentAccent}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.9"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FluentText}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Trigger></Style.Triggers>
    </Style>
</ResourceDictionary>
