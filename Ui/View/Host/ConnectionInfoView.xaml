<styles:WindowChromeBase x:Class="_1RM.View.Host.ConnectionInfoView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:host="clr-namespace:_1RM.View.Host"
                         xmlns:styles="clr-namespace:Shawn.Utils.WpfResources.Theme.Styles;assembly=Shawn.Utils.WpfResources"
                         mc:Ignorable="d"
                         d:DataContext="{d:DesignInstance host:ConnectionInfoViewModel}"
                         Title="{Binding WindowTitle}"
                         Width="620"
                         Height="650"
                         MinWidth="480"
                         MinHeight="360"
                         WindowStartupLocation="CenterOwner"
                         ResizeMode="NoResize"
                         WindowStyle="None"
                         Background="Transparent"
                         AllowsTransparency="True"
                         ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" />
    </WindowChrome.WindowChrome>

    <Border Margin="18"
            Background="{DynamicResource PrimaryMidBrush}"
            BorderBrush="{DynamicResource PrimaryLightBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource DefaultCornerRadius}"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AccentMidBrush}"
                    Padding="16 0">
                <Grid>
                    <TextBlock Text="{Binding WindowTitle}"
                               Foreground="{DynamicResource AccentTextBrush}"
                               FontSize="{DynamicResource GlobalFontSizeSubtitle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Command="{Binding CmdClose}"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Right"
                            Style="{StaticResource ButtonBarPrimaryStyle}"
                            Foreground="{DynamicResource AccentTextBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="✕"
                            FontSize="15" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="18 16 18 10"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="12 10"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{DynamicResource DefaultBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DefaultCornerRadius}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ"
                                       Margin="0 0 10 0"
                                       Foreground="{DynamicResource AccentMidBrush}"
                                       FontSize="25"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Summary}"
                                       Foreground="{DynamicResource BackgroundTextBrush}"
                                       FontSize="{DynamicResource GlobalFontSizeSubtitle}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0 16 0 0">
                                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontSize="{DynamicResource GlobalFontSizeSubtitle}"
                                               FontWeight="SemiBold"
                                               Margin="0 0 0 6">
                                        <Run Text="[" />
                                        <Run Text="{Binding Title}" />
                                        <Run Text="]" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0 2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               Opacity="0.78"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource 'This information is a snapshot captured when the window was opened.'}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Opacity="0.55"
                               Margin="0 18 0 0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource DefaultBorderBrush}"
                    BorderThickness="0 1 0 0"
                    Padding="16 8">
                <Grid>
                    <TextBlock Text="{Binding CopyStatus}"
                               Foreground="{DynamicResource AccentMidBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CmdCopy}"
                                Content="{DynamicResource 'Copy all'}"
                                MinWidth="100"
                                Margin="0 0 8 0" />
                        <Button Command="{Binding CmdClose}"
                                Content="{DynamicResource OK}"
                                MinWidth="80"
                                IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CmdClose}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CmdCopy}" />
    </Window.InputBindings>
</styles:WindowChromeBase>
