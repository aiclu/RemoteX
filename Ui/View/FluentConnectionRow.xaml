<UserControl x:Class="_1RM.View.FluentConnectionRow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:_1RM.View" MinHeight="40" ToolTip="{Binding Server.SubTitle}">
 <Grid Margin="8,4">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="32"/><ColumnDefinition Width="32"/>
   <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="Auto"/>
  </Grid.ColumnDefinitions>
  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="SelectionClick" VerticalAlignment="Center"
            ToolTip="{Binding DisplayName}" AutomationProperties.Name="{Binding DisplayName}"/>
  <Image Grid.Column="1" Source="{Binding Server.IconImg}" Width="20" Height="20" Margin="0,0,8,0"/>
  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
   <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" FontWeight="SemiBold"
              Foreground="{DynamicResource BackgroundTextBrush}" TextTrimming="CharacterEllipsis"/>
   <TextBlock Text="{Binding Server.SubTitle}" ToolTip="{Binding Server.SubTitle}" Opacity="0.75"
              Foreground="{DynamicResource BackgroundTextBrush}" TextTrimming="CharacterEllipsis">
    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
     <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(local:FluentWorkspace.IsCompact)}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  </StackPanel>
   <TextBlock Grid.Column="3" Text="{Binding Server.ProtocolDisplayName}" Margin="0,0,12,0"
             VerticalAlignment="Center" Opacity="0.75" Foreground="{DynamicResource BackgroundTextBrush}">
    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
     <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(local:FluentWorkspace.IsCompact)}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
  <Button Grid.Column="4" Style="{DynamicResource FluentButton}" Content="{DynamicResource Connect}"
          Command="{Binding CmdConnServer}" Padding="8,4" MinHeight="28" VerticalAlignment="Center"/>
 </Grid>
</UserControl>
