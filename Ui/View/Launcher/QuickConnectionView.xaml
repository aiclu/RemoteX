<UserControl x:Class="_1RM.View.Launcher.QuickConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_1RM.View.Launcher"
             xmlns:view="clr-namespace:_1RM.View"
             xmlns:model="clr-namespace:_1RM.Model"
             xmlns:attachProperty="clr-namespace:Shawn.Utils.WpfResources.Theme.AttachProperty;assembly=Shawn.Utils.WpfResources"
             d:DataContext="{d:DesignInstance local:QuickConnectionViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary  Source="LauncherDictionary.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <VisualBrush x:Key="HintText" TileMode="None" Stretch="None" AlignmentX="Left">
                <VisualBrush.Visual>
                    <Grid VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TextBlockBase}" FontStyle="Italic" Text="quick connect e.g. 192.168.0.100:3389" Foreground="Black" Opacity="0.5" FontSize="{DynamicResource GlobalFontSizeTitle}" />
                        <TextBlock Style="{StaticResource TextBlockBase}" FontStyle="Italic" Text="quick connect e.g. 192.168.0.100:3389" Foreground="White" Opacity="0.5" FontSize="{DynamicResource GlobalFontSizeTitle}" />
                    </Grid>
                </VisualBrush.Visual>
            </VisualBrush>


            <Style x:Key="SearchBoxTbKeyWordStyle" TargetType="TextBox" BasedOn="{StaticResource SearchBoxTbKeyWordStyleBase}">
                <Style.Triggers>
                    <Trigger Property="Text" Value="{x:Null}">
                        <Setter Property="Background" Value="{StaticResource HintText}" />
                    </Trigger>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Background" Value="{StaticResource HintText}" />
                    </Trigger>
                </Style.Triggers>
            </Style>




            <DataTemplate x:Key="ClassicQuickResult">
                <Grid Height="{Binding RelativeSource={RelativeSource Self}, Path=(view:FluentLauncher.RowHeight)}">
                    <Grid VerticalAlignment="Center" 
                      >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>



                        <TextBlock Grid.Column="0"
                                   Text="{Binding Host}"
                                   ToolTip="{Binding Host}" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource GlobalFontSizeSubtitle}"
                                   Margin="10 0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger><MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(view:FluentPage.Active)}" Value="True"/>
                                            <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"/>
                                        </MultiDataTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource FluentAccentText}"/></MultiDataTrigger>
                                        <DataTrigger Binding="{Binding Protocol}" Value="">
                                            <Setter Property="FontWeight" Value="Bold"></Setter>
                                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                                            <Setter Property="Grid.ColumnSpan" Value="2"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Protocol}"
                                   FontSize="{DynamicResource GlobalFontSizeSubtitle}" FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   Margin="5 0 0 0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBase}">
                                <Setter Property="Opacity" Value="0.3"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource FluentMuted}"/></Trigger>
                                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=(view:FluentPage.Active)}" Value="True"/>
                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"/>
                                    </MultiDataTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource FluentAccentText}"/></MultiDataTrigger>
                                </Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>


                        <Button Grid.Column="2" Width="10" Height="10" 
                                Background="Transparent"
                                attachProperty:VisionElement.Opacity="0.5"
                                attachProperty:VisionElement.OpacityAccent="0.9"
                                attachProperty:VisionElement.BackgroundAccent="Transparent"
                                Margin="5 0 10 0"
                                Tag="{Binding}"
                                PreviewMouseLeftButtonUp="ButtonDeleteItem_OnClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonBarAccentStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Protocol}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid Height="10" Width="8">
                                <Path Data="F1 M 47.910156 -44.000000 L 87.183594 -4.683594 L 83.316406 -0.816406 L 44.000000 -40.089844 L 4.683594 -0.816406 L 0.816406 -4.683594 L 40.089844 -44.000000 L 0.816406 -83.316406 L 4.683594 -87.183594 L 44.000000 -47.910156 L 83.316406 -87.183594 L 87.183594 -83.316406 Z "
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"
                                      StrokeThickness="2" Stretch="Uniform" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </DataTemplate>



            <DataTemplate x:Key="FluentQuickResult">
                <Grid Height="{Binding RelativeSource={RelativeSource Self}, Path=(view:FluentLauncher.RowHeight)}" Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Host}" ToolTip="{Binding Host}" Style="{StaticResource LauncherTitleText}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Protocol}" Style="{StaticResource LauncherSecondaryText}" Margin="0,0,4,0" MaxWidth="70"/>
                    <Button Grid.Column="2" Tag="{Binding}" VerticalAlignment="Center" ToolTip="{DynamicResource Delete}" AutomationProperties.Name="{DynamicResource Delete}" Click="ButtonDeleteItem_OnClick">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource LauncherIconButton}"><Style.Triggers><DataTrigger Binding="{Binding Protocol}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                        <Path Width="10" Height="10" Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:QuickConnectionItem}">
                <ContentControl Content="{Binding}" IsTabStop="False" HorizontalContentAlignment="Stretch"><ContentControl.Style><Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource ClassicQuickResult}"/>
                    <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource FluentQuickResult}"/></Trigger></Style.Triggers>
                </Style></ContentControl.Style></ContentControl>
            </DataTemplate>
            <Style x:Key="ListBoxItemStyleForQuickConnect" TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemStyleForServer}">
                <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True"><Setter Property="Template" Value="{StaticResource LauncherItemTemplate}"/></Trigger></Style.Triggers>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="GridContainer"></Border>
                                <Grid x:Name="GridColorOnSelected" 
                                      Visibility="Collapsed"
                                      Width="40" 
                                      HorizontalAlignment="Left" ></Grid>
                                <ContentPresenter x:Name="ContentPresenter"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="view:FluentPage.Active" Value="True">
                                    <Setter TargetName="GridContainer" Property="CornerRadius" Value="6"/>
                                    <Setter TargetName="GridContainer" Property="Margin" Value="4,1"/>
                                </Trigger>
                                <MultiTrigger><MultiTrigger.Conditions><Condition Property="view:FluentPage.Active" Value="True"/><Condition Property="IsKeyboardFocusWithin" Value="True"/></MultiTrigger.Conditions>
                                    <Setter TargetName="GridContainer" Property="BorderBrush" Value="{DynamicResource FluentText}"/><Setter TargetName="GridContainer" Property="BorderThickness" Value="1"/>
                                </MultiTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="GridContainer" Value="{DynamicResource PrimaryTextBrush}"></Setter>
                                    <Setter Property="Opacity" Value="0.2" TargetName="GridContainer" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Opacity" Value="1" TargetName="GridContainer" />
                                    <Setter Property="Background" Value="{DynamicResource AccentMidBrush}" TargetName="GridContainer" />
                                    <Setter TargetName="GridColorOnSelected" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListQuickConnect" TargetType="{x:Type ListBox}" BasedOn="{StaticResource SearchBoxSelectionList}">
                <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItemStyleForQuickConnect}"></Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource PrimaryMidBrush}" view:FluentLauncher.QuickMode="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Name="GridKeyword" Height="{Binding RelativeSource={RelativeSource Self}, Path=(view:FluentLauncher.SearchHeight)}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <ComboBox TabIndex="1"
                      IsTabStop="False"
                      Grid.Column="0"
                      DisplayMemberPath="Protocol"
                      SelectedItem="{Binding SelectedProtocol}"
                      ItemsSource="{Binding Protocols}">
                <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Margin" Value="3,8"/>
                    <Style.Triggers><Trigger Property="view:FluentPage.Active" Value="True">
                        <Setter Property="Margin" Value="8,6"/><Setter Property="MinWidth" Value="68"/><Setter Property="MaxWidth" Value="112"/>
                        <Setter Property="FontSize" Value="{DynamicResource GlobalFontSizeBody}"/>
                        <Setter Property="Foreground" Value="{DynamicResource FluentText}"/><Setter Property="Background" Value="{DynamicResource FluentSurface}"/>
                    </Trigger></Style.Triggers>
                </Style></ComboBox.Style>
            </ComboBox>

            <TextBox Name="TbKeyWord" Tag="{DynamicResource FluentQuickConnectHint}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     PreviewKeyDown="TbKeyWord_OnPreviewKeyDown"
                     Margin="0 0 0 0"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SearchBoxTbKeyWordStyle}"
                     Grid.Column="1" 
                     ></TextBox>
        </Grid>

        <ListBox x:Name="ListBoxHistory"
                 Grid.Row="1"
                 BorderThickness="0"
                 PreviewMouseLeftButtonDown="ListBoxHistory_OnPreviewMouseLeftButtonDown"
                 SelectedIndex="{Binding SelectedIndex}"
                 ItemsSource="{Binding ConnectHistory}"
                 Style="{StaticResource ListQuickConnect}"
                 >
        </ListBox>
    </Grid>
</UserControl>
