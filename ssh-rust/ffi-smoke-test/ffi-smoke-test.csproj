<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SshRustSmokeTest</RootNamespace>
    <AssemblyName>ffi-smoke-test</AssemblyName>
  </PropertyGroup>

  <!-- Copy the compiled Rust cdylib next to the test exe so LibraryImport can find it.
       Prefer the release build (what the UI ships), fall back to debug. -->
  <Target Name="CopyRustDll" BeforeTargets="Build">
    <ItemGroup>
      <RustDll Include="..\target\release\ssh_rust.dll" Condition="Exists('..\target\release\ssh_rust.dll')" />
      <RustDll Include="..\target\debug\ssh_rust.dll" Condition="!Exists('..\target\release\ssh_rust.dll') and Exists('..\target\debug\ssh_rust.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(RustDll)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
